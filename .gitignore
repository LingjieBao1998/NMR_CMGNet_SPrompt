!viz_tmp/coords_fit.npy
!viz_tmp/coords_rest.npy
!viz_tmp/fit_idx.npy
!viz_tmp/rest_idx.npy
!viz_tmp/train_labels.npy
!viz_tmp/test_labels.npy
!viz_tmp/train_emb_subset.npz
!viz_tmp/f48_pred.npz
__pycache__/
*.pyc
*.log
.DS_Store
