# Docker environment file (template). docker-compose.yml reads this file.
# Fill in the real SMTP account below; keep credentials out of git.

# Django配置
DJANGO_SETTINGS_MODULE=nmr_core_system.settings

# Celery配置(容器内Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 邮件配置(网易163) — replace with your own account
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your_account@example.com
EMAIL_HOST_PASSWORD=your_smtp_authorisation_code
DEFAULT_FROM_EMAIL=your_account@example.com
EMAIL_TIMEOUT=30
EMAIL_SUBJECT_PREFIX=[NMR检测系统]

# 网站基础URL（注册/重置密码邮件里的链接）
SITE_URL=http://localhost:8888/

# Django security (override in production)
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
